# install.sh generates the key locally. Never commit or share it in chat.
IMAGE_API_KEY=
HOST=127.0.0.1
PORT=8010
MODEL_ID=black-forest-labs/FLUX.2-klein-4B
# Optional: pin a downloaded model revision to a specific Hugging Face commit.
MODEL_REVISION=
DATA_DIR=./data
HF_HOME=./data/huggingface
# Respect the notebook's existing CUDA_VISIBLE_DEVICES unless explicitly set here.
# CUDA_VISIBLE_DEVICES=MIG-...
MAX_ACTIVE_JOBS=16
MAX_JOB_SECONDS=300
# Keep headroom for the existing TTS process on the 47 GB MIG slice.
GPU_MEMORY_FRACTION=0.65
# Optional accounting estimate, in EUR per allocated GPU-hour. Not a billing API.
GPU_HOURLY_EUR=
